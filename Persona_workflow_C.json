      "parameters": {
        "jsCode": "const { uid, token } = $json.query || {};\n\nif (!uid || !token) {\n  return [{ json: { valid: false, reason: 'Paramètres manquants', uid: null } }];\n}\n\nconst simpleHash = str => {\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    hash = ((hash << 5) - hash) + str.charCodeAt(i);\n    hash |= 0;\n  }\n  return Math.abs(hash).toString(16);\n};\n\nconst expectedToken = simpleHash(uid + 'CHANGE_ME_SECRET_SALT');\nconst valid = token === expectedToken;\n\nreturn [{ json: { valid, uid, reason: valid ? 'OK' : 'Token invalide' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
