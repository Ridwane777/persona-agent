    },
    {
      "parameters": {
        "jsCode": "const { uid, token } = $json.query || {};\n\nif (!uid || !token) {\n  return [{ json: { valid: false, reason: 'Paramètres manquants', uid: null } }];\n}\n\n// Recalculer le token attendu\nconst crypto = require('crypto');\nconst expectedToken = crypto.createHash('sha256')\n  .update(uid + 'CHANGE_ME_SECRET_SALT')\n  .digest('hex')\n  .substring(0, 16);\n\nconst valid = token === expectedToken;\n\nreturn [{ json: { valid, uid, reason: valid ? 'OK' : 'Token invalide' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-580, 0],
      "id": "verify-token-001",
      "name": "Vérifier token"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 3 },
          "conditions": [
            {
              "id": "token-valid-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "true",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-360, 0],
      "id": "if-token-valid-001",
      "name": "Token valide?"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "users",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $json.uid }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "is_active", "fieldValue": "=false" },
            { "fieldId": "email", "fieldValue": "={{ 'deleted_' + $json.uid + '@persona.local' }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-140, -120],
      "id": "deactivate-user-001",
      "name": "Désactiver compte",
      "credentials": { "supabaseApi": { "id": "SUPABASE_CREDENTIAL_ID", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "operation": "delete",
