      "name": "Supprimer sessions",
      "credentials": { "supabaseApi": { "id": "SUPABASE_CREDENTIAL_ID", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"><title>Désinscription confirmée</title><style>body{font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f3f4f6}.card{background:white;border-radius:12px;padding:48px;text-align:center;max-width:400px;box-shadow:0 4px 6px rgba(0,0,0,.07)}.icon{font-size:48px;margin-bottom:16px}h1{color:#1e1b4b;margin:0 0 12px}p{color:#6b7280;line-height:1.6}</style></head><body><div class=\"card\"><div class=\"icon\">✅</div><h1>Désinscription confirmée</h1><p>Tes données ont été supprimées conformément au RGPD. Tu ne recevras plus de newsletter Persona.</p><p style=\"margin-top:24px;font-size:13px\">Tu peux te réinscrire à tout moment via le chatbot.</p></div></body></html>",
