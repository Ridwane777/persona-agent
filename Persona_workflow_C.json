{
  "name": "Persona — Workflow C (Désinscription)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "unsubscribe",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-800, 0],
      "id": "webhook-unsub-001",
