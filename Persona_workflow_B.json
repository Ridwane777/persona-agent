        "jsCode": "// R\u00e9cup\u00e9rer les infos utilisateur et pr\u00e9f\u00e9rences\nconst user = $('Utilisateurs actifs').item.json;\nconst prefs = $('Pr\u00e9f\u00e9rences user').item.json;\n\n// Construire l'objet complet\nreturn [{\n  json: {\n    user_id: user.id,\n    username: user.username,\n    email: user.email,\n    topics: prefs.topics || [],\n    language: prefs.language || 'fr',\n    num_articles: prefs.num_articles || 5,\n    custom_prompt: prefs.custom_prompt || null\n  }\n}];"
