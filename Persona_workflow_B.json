    {
      "parameters": {
        "jsCode": "const articles = $json.articles;\nconst userName = $json.username;\nconst userId = $json.user_id;\nconst unsubToken = require('crypto').createHash('sha256').update(userId + 'CHANGE_ME_SECRET_SALT').digest('hex').substring(0, 16);\nconst date = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'nuuser', month: 'long', year: 'nuuser' });\n\nconst articleCards = articles.map((a, i) => `\n  <tr>\n    <td style=\"padding: 0 0 28px 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-left: 3px solid #6366f1; padding-left: 16px;\">\n        <tr><td>\n          <p style=\"margin: 0 0 2px; font-size: 11px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em;\">${a.source} \u2022 Article ${i+1}</p>\n          <h2 style=\"margin: 0 0 8px; font-size: 16px; line-height: 1.4;\">\n            <a href=\"${a.url}\" style=\"color: #1e1b4b; text-decoration: none;\">${a.title}</a>\n          </h2>\n          <p style=\"margin: 0 0 10px; font-size: 14px; color: #4b5563; line-height: 1.6;\">${a.summary}</p>\n          <a href=\"${a.url}\" style=\"font-size: 13px; color: #6366f1; text-decoration: none; font-weight: 600;\">Lire l'article \u2192</a>\n        </td></tr>\n      </table>\n    </td>\n  </tr>\n`).join('');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Persona Newsletter</title></head>\n<body style=\"margin:0; padding:0; background-color:#f3f4f6; font-family: 'Helvetica Neue', Arial, sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f4f6; padding: 32px 16px;\">\n    <tr><td align=\"center\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px; width:100%;\">\n        <!-- HEADER -->\n        <tr><td style=\"background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border-radius: 12px 12px 0 0; padding: 32px; text-align: center;\">\n          <p style=\"margin:0 0 4px; font-size:12px; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:0.1em;\">\ud83d\udcf0 Ta newsletter personnalis\u00e9e</p>\n          <h1 style=\"margin:0 0 8px; font-size:28px; color:white; font-weight:800;\">Persona</h1>\n          <p style=\"margin:0; font-size:14px; color:rgba(255,255,255,0.85);\">${date}</p>\n        </td></tr>\n        <!-- INTRO -->\n        <tr><td style=\"background:white; padding: 32px 32px 0;\">\n          <p style=\"margin:0; font-size:16px; color:#374151;\">Bonjour <strong>${userName}</strong> \ud83d\udc4b</p>\n          <p style=\"margin:12px 0 0; font-size:14px; color:#6b7280; line-height:1.6;\">Voici ta s\u00e9lection du jour, choisie et r\u00e9sum\u00e9e par l'IA selon tes centres d'int\u00e9r\u00eat.</p>\n        </td></tr>\n        <!-- DIVIDER -->\n        <tr><td style=\"background:white; padding: 20px 32px;\"><hr style=\"border:none; border-top:1px solid #e5e7eb;\"></td></tr>\n        <!-- ARTICLES -->\n        <tr><td style=\"background:white; padding: 0 32px;\">\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n            ${articleCards}\n          </table>\n        </td></tr>\n        <!-- FOOTER -->\n        <tr><td style=\"background:#f9fafb; border-top:1px solid #e5e7eb; border-radius:0 0 12px 12px; padding:24px 32px; text-align:center;\">\n          <p style=\"margin:0 0 8px; font-size:12px; color:#9ca3af;\">Tu re\u00e7ois cet email car tu es abonn\u00e9(e) \u00e0 Persona.</p>\n          <p style=\"margin:0; font-size:12px; color:#9ca3af;\">\n            <a href=\"YOUR_N8N_BASE_URL/webhook/unsubscribe?uid=${userId}&token=${unsubToken}\" style=\"color:#6366f1;\">Se d\u00e9sinscrire</a>\n            &nbsp;\u2022&nbsp;\n            <a href=\"YOUR_CHATBOT_URL\" style=\"color:#6366f1;\">Modifier mes pr\u00e9f\u00e9rences</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{ json: { html, subject: `\ud83d\udcf0 Ta newsletter Persona \u2014 ${date}`, email: $json.email, username: userName, user_id: userId, articles } }];"
      },
