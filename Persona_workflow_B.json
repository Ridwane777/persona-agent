    {
      "parameters": {
        "jsCode": "// Normaliser et d\u00e9dupliquer tous les articles\nconst userData = $('Loop Users').first().json;\nconst allItems = $input.all();\n\nconst normalize = (item) => {\n  const a = item.json;\n  // NewsAPI\n  if (a.source && a.url && a.publishedAt) {\n    return {\n      title: a.title || 'Sans titre',\n      description: (a.description || a.content || '').substring(0, 400),\n      url: a.url,\n      source: a.source?.name || 'NewsAPI',\n      publishedAt: a.publishedAt\n    };\n  }\n  // Guardian\n  if (a.webUrl || a.webTitle) {\n    return {\n      title: a.webTitle || 'Sans titre',\n      description: a.fields?.trailText || '',\n      url: a.webUrl,\n      source: 'The Guardian',\n      publishedAt: a.webPublicationDate || new Date().toISOString()\n    };\n  }\n  // RSS\n  if (a.link || a.guid) {\n    return {\n      title: a.title || 'Sans titre',\n      description: a.contentSnippet || a.summary || '',\n      url: a.link || a.guid,\n      source: a.creator || 'BBC News',\n      publishedAt: a.pubDate || new Date().toISOString()\n    };\n  }\n  return null;\n};\n\nconst articles = allItems\n  .map(i => normalize(i))\n  .filter(a => a && a.url && a.title);\n\n// D\u00e9duplication par URL\nconst seen = new Set();\nconst unique = articles.filter(a => {\n  if (seen.has(a.url)) return false;\n  seen.add(a.url);\n  return true;\n});\n\n// Pr\u00e9-filtrage par topics pour \u00e9conomiser des tokens\nconst topics = userData.topics || [];\nconst filtered = unique.filter(a => {\n  if (topics.length === 0) return true;\n  const text = (a.title + ' ' + a.description).toLowerCase();\n  return topics.some(t => text.includes(t.toLowerCase()));\n});\n\n// Fact-checking crois\u00e9 : score de confirmation\nconst scored = filtered.map(a => {\n  const keywords = a.title.split(' ').filter(w => w.length > 4).slice(0, 3);\n  const confirmedBy = filtered.filter(b =>\n    b.url !== a.url &&\n    b.source !== a.source &&\n    keywords.some(kw => b.title.toLowerCase().includes(kw.toLowerCase()))\n  );\n  return { ...a, factCheckScore: confirmedBy.length };\n});\n\n// Trier par score de confirmation puis limiter\nconst final = scored\n  .sort((a, b) => b.factCheckScore - a.factCheckScore)\n  .slice(0, 25);\n\nreturn final.map(a => ({ json: { ...a, userData } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "normalize-dedup-001",
