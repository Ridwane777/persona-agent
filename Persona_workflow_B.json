    {
      "parameters": {
        "jsCode": "// Parser la r\u00e9ponse JSON de l'IA\nconst raw = $json.text || $json.output || '';\n\nlet parsed;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    parsed = JSON.parse(match[0]);\n  }\n} catch(e) {\n  return [{ json: { error: 'Parse error: ' + e.message, raw } }];\n}\n\nif (!parsed || !parsed.articles) {\n  return [{ json: { error: 'No articles in response', raw } }];\n}\n\nconst userData = $('Loop Users').first().json;\n\nreturn [{ json: {\n  articles: parsed.articles,\n  userData,\n  user_id: userData.user_id,\n  username: userData.username,\n  email: userData.email\n} }];"
      },
