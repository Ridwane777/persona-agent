    },
    {
      "parameters": {
        "jsCode": "// Agr\u00e9ger tous les articles normalis\u00e9s + context utilisateur\nconst items = $input.all();\nif (items.length === 0) return [];\n\nconst userData = items[0].json.userData;\nconst articles = items.map(i => ({\n  title: i.json.title,\n  description: i.json.description,\n  url: i.json.url,\n  source: i.json.source,\n  publishedAt: i.json.publishedAt,\n  factCheckScore: i.json.factCheckScore\n}));\n\nreturn [{ json: { userData, articles } }];"
      },
