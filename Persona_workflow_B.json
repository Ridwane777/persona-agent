    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Tu es un \u00e9diteur de newsletter expert. Voici les pr\u00e9f\u00e9rences de l\\'abonn\u00e9 :\\n\\nCentres d\\'int\u00e9r\u00eat : ' + JSON.stringify($json.userData.topics) + '\\nLangue : ' + $json.userData.language + '\\nNombre d\\'articles souhait\u00e9s : ' + $json.userData.num_articles + (($json.userData.custom_prompt) ? ('\\nInstructions personnalis\u00e9es : ' + $json.userData.custom_prompt) : '') + '\\n\\nVoici ' + $json.articles.length + ' articles disponibles aujourd\\'hui :\\n' + JSON.stringify($json.articles) + '\\n\\nS\u00e9lectionne exactement ' + $json.userData.num_articles + ' articles qui correspondent le mieux aux centres d\\'int\u00e9r\u00eat.\\nPour chaque article s\u00e9lectionn\u00e9, r\u00e9dige un r\u00e9sum\u00e9 de 2-3 phrases en ' + $json.userData.language + '.\\n\\nR\u00e9ponds UNIQUEMENT avec ce JSON valide, sans texte avant ni apr\u00e8s :\\n{\"articles\": [{\"title\": \"...\", \"summary\": \"...\", \"url\": \"...\", \"source\": \"...\"}]}' }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        660,
        0
      ],
